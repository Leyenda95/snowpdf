{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnowPDF",
  "mainBinaryName": "SnowPDF",
  "version": "0.1.0",
  "identifier": "com.snowpdf.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SnowPDF",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "languages": ["English", "Spanish"]
      }
    },
    "shortDescription": "Editor y herramientas PDF 100% locales",
    "longDescription": "SnowPDF permite ver, editar, rellenar, firmar, organizar, unir, dividir, comprimir y proteger documentos PDF sin subirlos a ningún servidor.",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF",
        "description": "Documento PDF",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
